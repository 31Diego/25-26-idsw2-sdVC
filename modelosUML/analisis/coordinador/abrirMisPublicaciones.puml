@startuml abrirMisPublicaciones-analisis
skinparam linetype polyline

rectangle #CDEBA5 ":PANEL_PRINCIPAL_ABIERTO" as PanelPrincipal

package abrirMisPublicaciones as "abrirMisPublicaciones()" {
    rectangle #629EF9 MisPublicacionesView
    rectangle #b5bd68 PublicacionController
    rectangle #F2AC4E PublicacionRepository
    rectangle #F2AC4E Publicacion
}

rectangle #CDEBA5 ":MIS_PUBLICACIONES_ABIERTAS" as MisPublicacionesAbiertas
rectangle #CDEBA5 ":Collaboration AbrirMiPublicacion" as ColPublicacion
rectangle #CDEBA5 ":Collaboration CrearPublicacion" as ColCrear
rectangle #CDEBA5 ":PANEL_PRINCIPAL_ABIERTO" as PanelSalida

PanelPrincipal -r-> MisPublicacionesView: abrirMisPublicaciones()

MisPublicacionesView -d-> PublicacionController: obtenerMisPublicaciones() : List<Publicacion>

PublicacionController --> PublicacionRepository: obtenerPorAutor(id) : List<Publicacion>

PublicacionRepository -- Publicacion

MisPublicacionesView ..> MisPublicacionesAbiertas: publicacionesCargadas()
MisPublicacionesView ..> ColPublicacion: abrirMiPublicacion(id)
MisPublicacionesView ..> ColCrear: crearPublicacion()
MisPublicacionesView ..> PanelSalida: abrirPanelPrincipal()

@enduml
