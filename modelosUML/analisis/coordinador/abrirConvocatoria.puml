@startuml abrirConvocatoria-analisis
skinparam linetype polyline

rectangle #CDEBA5 ":CONVOCATORIAS_ABIERTAS" as ConvocatoriasAbiertas

package abrirConvocatoria as "abrirConvocatoria()" {
    rectangle #629EF9 ConvocatoriaView
    rectangle #b5bd68 ConvocatoriaController
    rectangle #F2AC4E ConvocatoriaRepository
    rectangle #F2AC4E Convocatoria
}

rectangle #CDEBA5 "CONVOCATORIA_ABIERTA" as ConvocatoriaAbierta
rectangle #CDEBA5 ":Collaboration ImportarConvocatoria" as ImportarConvocatoria
rectangle #CDEBA5 ":CONVOCATORIAS_ABIERTAS" as ConvocatoriasAbiertasSalida

ConvocatoriasAbiertas -r-> ConvocatoriaView: abrirConvocatoria(id)

ConvocatoriaView -d-> ConvocatoriaController: obtenerConvocatoria(id) : Convocatoria

ConvocatoriaController --> ConvocatoriaRepository: obtenerPorId(id) : Convocatoria

ConvocatoriaRepository -- Convocatoria

ConvocatoriaView ..> ConvocatoriaAbierta: convocatoriaMostrada()
ConvocatoriaView ..> ImportarConvocatoria: importarConvocatoria()
ConvocatoriaView ..> ConvocatoriasAbiertasSalida: abrirConvocatorias()

@enduml
