@startuml editarProyecto-diseño
skinparam linetype ortho

actor "Coordinador" as Coord
participant "Navegador" as Nav
participant "EditarProyectoController\n@Controller\nGET|POST /proyectos/{id}/editar" as Ctrl
participant "ProyectoService\n@Service" as Service
participant "ProyectoRepository\nJpaRepository" as Repo
database "H2" as DB

Coord -> Nav : clic en "Editar"
activate Nav
Nav -> Ctrl : GET /proyectos/{id}/editar
activate Ctrl
Ctrl -> Service : obtenerProyecto(id)
activate Service
Service -> Repo : findById(id)
activate Repo
Repo -> DB : SELECT * FROM proyectos WHERE id = ?
DB --> Repo : Proyecto
deactivate Repo
Repo --> Service : Proyecto
deactivate Service
Service --> Ctrl : Proyecto
Ctrl -> Ctrl : model.addAttribute("proyecto", proyecto)
Ctrl --> Nav : 200 OK · editar-proyecto.html [formulario pre-relleno]
deactivate Ctrl
Nav --> Coord : muestra formulario pre-relleno
deactivate Nav

Coord -> Nav : envía formulario modificado
activate Nav
Nav -> Ctrl : POST /proyectos/{id}/editar\n[campos modificados]
activate Ctrl

Ctrl -> Service : actualizarProyecto(id, datos)
activate Service
Service -> Repo : findById(id)
activate Repo
Repo -> DB : SELECT * FROM proyectos WHERE id = ?
DB --> Repo : Proyecto
deactivate Repo
note over Service : modificarCampos — \ncopia campos del formulario\nal objeto cargado
Service -> Repo : save(proyecto)
activate Repo
Repo -> DB : UPDATE proyectos SET ... WHERE id = ?
DB --> Repo : Proyecto
deactivate Repo
Repo --> Service : Proyecto
deactivate Service
Service --> Ctrl : Proyecto

Ctrl --> Nav : 302 redirect → /proyectos/{id}
deactivate Ctrl
Nav --> Coord : navega a /proyectos/{id}
deactivate Nav

@enduml
