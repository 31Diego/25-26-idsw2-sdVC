@startuml abrirOpcionesCargaTrabajo-coordinador-diseño
skinparam linetype ortho

actor "Coordinador" as Coord
participant "Navegador" as Nav
participant "CargaTrabajoController\n@Controller\nGET /carga-trabajo" as Ctrl
participant "InvestigadorService\n@Service" as Service
participant "InvestigadorRepository\nJpaRepository" as Repo
database "H2" as DB

Coord -> Nav : clic en "Carga de trabajo"
activate Nav
Nav -> Ctrl : GET /carga-trabajo
activate Ctrl
Ctrl -> Ctrl : investigador.getRol() == COORDINADOR
Ctrl -> Service : obtenerInvestigadores(null)
activate Service
Service -> Repo : findAll()
activate Repo
Repo -> DB : SELECT * FROM investigadores
DB --> Repo : List<Investigador> [con CargaTrabajo EAGER]
deactivate Repo
Repo --> Service : List<Investigador>
deactivate Service
Service --> Ctrl : List<Investigador>
Ctrl -> Ctrl : model.addAttribute("investigadores", lista)
Ctrl --> Nav : 200 OK · carga-trabajo.html
deactivate Ctrl
Nav --> Coord : muestra tabla global de carga de trabajo
deactivate Nav

@enduml
