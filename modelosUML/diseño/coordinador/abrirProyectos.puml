@startuml abrirProyectos-diseño
skinparam linetype ortho

actor "Coordinador" as Coord
participant "Navegador" as Nav
participant "ProyectoController\n@Controller\nGET /proyectos" as Ctrl
participant "ProyectoService\n@Service" as Service
participant "ProyectoRepository\nJpaRepository" as Repo
database "H2" as DB

Coord -> Nav : clic en "Proyectos"
activate Nav
Nav -> Ctrl : GET /proyectos
activate Ctrl

Ctrl -> Service : obtenerProyectosParaUsuario(investigador, criterio)
activate Service
alt sin filtro
    Service -> Repo : findAll()
    activate Repo
    Repo -> DB : SELECT * FROM proyectos
    DB --> Repo : List<Proyecto>
    deactivate Repo
    Repo --> Service : List<Proyecto>
else con filtro (?criterio=...)
    Service -> Repo : buscarPorCriterio(criterio)
    activate Repo
    Repo -> DB : SELECT ... WHERE titulo LIKE %criterio%
    DB --> Repo : List<Proyecto>
    deactivate Repo
    Repo --> Service : List<Proyecto>
end
deactivate Service
Service --> Ctrl : List<Proyecto>

Ctrl -> Ctrl : model.addAttribute("proyectos", lista)
Ctrl --> Nav : 200 OK · proyectos.html
deactivate Ctrl
Nav --> Coord : muestra proyectos.html
deactivate Nav

@enduml
