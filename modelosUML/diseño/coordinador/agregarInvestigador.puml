@startuml agregarInvestigador-coordinador-diseño
skinparam linetype ortho

actor "Coordinador" as Coord
participant "Navegador" as Nav
participant "ProyectoController\n@Controller\nGET /proyectos/{id}/investigadores/agregar" as CtrlGet
participant "ProyectoController\n@Controller\nPOST /proyectos/{id}/investigadores/agregar" as CtrlPost
participant "ProyectoService\n@Service" as PService
participant "InvestigadorService\n@Service" as IService
participant "CargaTrabajoService\n@Service" as CTService
participant "ProyectoRepository\nJpaRepository" as PRepo
participant "InvestigadorRepository\nJpaRepository" as IRepo
database "H2" as DB

Coord -> Nav : clic en "Agregar investigador" en la vista del proyecto
activate Nav
Nav -> CtrlGet : GET /proyectos/{id}/investigadores/agregar
activate CtrlGet
CtrlGet -> PService : obtenerProyecto(id)
activate PService
PService -> PRepo : findById(id)
activate PRepo
PRepo -> DB : SELECT * FROM proyectos WHERE id = ?
DB --> PRepo : Proyecto
deactivate PRepo
PRepo --> PService : Proyecto
deactivate PService
PService --> CtrlGet : Proyecto
CtrlGet -> IService : obtenerNoMiembros(proyecto)
activate IService
IService -> IRepo : findAll()
activate IRepo
IRepo -> DB : SELECT * FROM investigadores
DB --> IRepo : List<Investigador>
deactivate IRepo
IRepo --> IService : List<Investigador>
IService -> IService : filtra los que ya son miembros del proyecto
deactivate IService
IService --> CtrlGet : List<Investigador> (disponibles)
CtrlGet -> CTService : obtenerIdsBloqueados(disponibles)
activate CTService
CTService --> CtrlGet : Set<Long> bloqueados (ids con ≥ 40 h/sem)
deactivate CTService
CtrlGet -> CtrlGet : model.addAttribute("proyecto", proyecto)\nmodel.addAttribute("disponibles", disponibles)\nmodel.addAttribute("bloqueados", bloqueados)
CtrlGet --> Nav : 200 OK · agregar-investigador.html
deactivate CtrlGet
Nav --> Coord : muestra lista; investigadores bloqueados con botón deshabilitado
deactivate Nav

Coord -> Nav : selecciona investigador y pulsa "Agregar"
activate Nav
Nav -> CtrlPost : POST /proyectos/{id}/investigadores/agregar (investigadorId)
activate CtrlPost
CtrlPost -> IService : obtenerInvestigador(investigadorId)
activate IService
IService -> IRepo : findById(investigadorId)
IRepo -> DB : SELECT * FROM investigadores WHERE id = ?
DB --> IRepo : Investigador
IRepo --> IService : Investigador
deactivate IService
IService --> CtrlPost : Investigador
CtrlPost -> CTService : excedeLimite(investigador)
activate CTService
CTService --> CtrlPost : boolean
deactivate CTService

alt carga < 40 h/sem
    CtrlPost -> PService : obtenerProyecto(id)
    activate PService
    PService -> PRepo : findById(id)
    PRepo -> DB : SELECT * FROM proyectos WHERE id = ?
    DB --> PRepo : Proyecto
    PRepo --> PService : Proyecto
    deactivate PService
    PService --> CtrlPost : Proyecto
    CtrlPost -> PService : agregarInvestigador(proyecto, investigador)
    activate PService
    PService -> PRepo : save(proyecto)
    PRepo -> DB : INSERT INTO proyecto_investigador ...
    PRepo --> PService : Proyecto
    deactivate PService
    CtrlPost --> Nav : redirect /proyectos/{id}
    Nav --> Coord : muestra proyecto con el investigador agregado
else carga ≥ 40 h/sem
    CtrlPost -> CtrlPost : redirectAttributes.addFlashAttribute("error", "...")
    CtrlPost --> Nav : redirect /proyectos/{id}/investigadores/agregar
    Nav --> Coord : muestra formulario con mensaje de error
end
deactivate CtrlPost
deactivate Nav

@enduml
