@startuml eliminarPerfil-diseño
skinparam linetype ortho

actor "Coordinador" as Coord
participant "Navegador" as Nav
participant "EliminacionController\n@Controller\nPOST /investigadores/{id}/eliminar-perfil" as Ctrl
participant "InvestigadorService\n@Service" as Service
participant "ProyectoRepository\nSolicitudEliminacionRepository\nInvestigadorRepository\nJpaRepository" as Repos
database "H2" as DB

Coord -> Nav : clic en "Aprobar y eliminar perfil"\n(desde solicitud-eliminacion.html)
activate Nav
Nav -> Ctrl : POST /investigadores/{id}/eliminar-perfil\n[@AuthenticationPrincipal coordinador]
activate Ctrl
Ctrl -> Service : eliminarPerfil(coordinador.getId(), id)
activate Service

note over Service : actorId != targetId\nguarda anti-autoeliminación

Service -> Repos : proyectoRepository.findAll()\n→ elimina de cada proyecto donde aparece
Service -> Repos : solicitudEliminacionRepository\n.deleteByInvestigadorId(id)
Service -> Repos : investigadorRepository.deleteById(id)
activate Repos
Repos -> DB : DELETE / UPDATE proyectos\nDELETE solicitudes\nDELETE investigador
DB --> Repos : OK
deactivate Repos
Service --> Ctrl : true
deactivate Service
Ctrl --> Nav : 302 redirect → /solicitudes-eliminacion
deactivate Ctrl
Nav --> Coord : vuelve a la lista de solicitudes
deactivate Nav

@enduml
