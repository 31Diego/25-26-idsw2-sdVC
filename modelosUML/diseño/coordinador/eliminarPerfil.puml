@startuml eliminarPerfil-diseño
skinparam linetype ortho

actor "Coordinador" as Coord
participant "Navegador" as Nav
participant "EliminarPerfilController\n@Controller\nGET|POST /investigadores/{id}/eliminar-perfil" as Ctrl
participant "InvestigadorService\n@Service" as Service
participant "ProyectoRepository\nSolicitudEliminacionRepository\nInvestigadorRepository\nJpaRepository" as Repos
database "H2" as DB

Coord -> Nav : clic en "Eliminar perfil"
activate Nav
Nav -> Ctrl : GET /investigadores/{id}/eliminar-perfil
activate Ctrl
Ctrl -> Ctrl : model.addAttribute("investigador", investigador)
Ctrl --> Nav : 200 OK · eliminar-perfil.html
deactivate Ctrl
Nav --> Coord : muestra página de confirmación

Coord -> Nav : confirma eliminación
Nav -> Ctrl : POST /investigadores/{id}/eliminar-perfil
activate Ctrl
Ctrl -> Service : eliminarPerfil(id)
activate Service
Service -> Repos : proyectoRepository.findAll()\n→ elimina de cada proyecto donde aparece
Service -> Repos : solicitudEliminacionRepository\n.deleteByInvestigadorId(id)
Service -> Repos : investigadorRepository.deleteById(id)
activate Repos
Repos -> DB : DELETE / UPDATE proyectos\nDELETE solicitudes\nDELETE investigador
DB --> Repos : OK
deactivate Repos
deactivate Service
Ctrl --> Nav : 302 redirect → /investigadores
deactivate Ctrl
Nav --> Coord : vuelve a la lista de investigadores
deactivate Nav

@enduml
