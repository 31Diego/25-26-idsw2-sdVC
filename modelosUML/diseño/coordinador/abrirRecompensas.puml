@startuml
title Diagrama de Secuencia — abrirRecompensas (Coordinador)

actor "Coordinador" as User
participant "RecompensaController\n@Controller" as Controller
participant "RecompensaService\n@Service" as Service
participant "RecompensaRepository\nJpaRepository" as Repo
database "H2" as DB

User -> Controller: GET /recompensas
activate Controller
Controller -> Service: obtenerTodas()
activate Service
Service -> Repo: findAll()
activate Repo
Repo -> DB: SELECT * FROM recompensas
activate DB
DB --> Repo: List<Recompensa>
deactivate DB
Repo --> Service: List<Recompensa>
deactivate Repo
Service --> Controller: List<Recompensa>
deactivate Service
Controller --> User: recompensas.html\n(listado completo)
deactivate Controller

@enduml
