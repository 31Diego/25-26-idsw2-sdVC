@startuml
title Diagrama de Secuencia — eliminarConvocatoria (Coordinador)

actor "Coordinador" as User
participant "ConvocatoriaController\n@Controller" as Controller
participant "ConvocatoriaService\n@Service" as Service
participant "ConvocatoriaRepository\nJpaRepository" as Repo
database "H2" as DB

User -> Controller: GET /convocatorias/{id}/eliminar
activate Controller
Controller -> Service: obtenerPorId(id)
activate Service
Service -> Repo: findById(id)
activate Repo
Repo -> DB: SELECT * FROM convocatorias WHERE id = ?
activate DB
DB --> Repo: Convocatoria
deactivate DB
Repo --> Service: Convocatoria
deactivate Repo
Service --> Controller: Convocatoria
deactivate Service
Controller --> User: eliminar-convocatoria.html\n(confirmación)
deactivate Controller

User -> Controller: POST /convocatorias/{id}/eliminar
activate Controller
Controller -> Service: eliminar(id)
activate Service
Service -> Repo: deleteById(id)
activate Repo
Repo -> DB: DELETE FROM convocatorias WHERE id = ?
activate DB
DB --> Repo: ok
deactivate DB
deactivate Repo
deactivate Service
Controller --> User: redirect:/convocatorias
deactivate Controller

@enduml
