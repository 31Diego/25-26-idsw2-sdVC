@startuml crearProyecto-diseño
skinparam linetype ortho

actor "Coordinador" as Coord
participant "CrearProyectoController\n@Controller\nGET|POST /proyectos/nuevo" as Ctrl
participant "ProyectoService\n@Service" as Service
participant "ProyectoRepository\nJpaRepository" as Repo
database "H2" as DB

Coord -> Ctrl : GET /proyectos/nuevo
activate Ctrl
Ctrl -> Ctrl : model.addAttribute("proyecto", new Proyecto())
Ctrl --> Coord : 200 OK · crear-proyecto.html
deactivate Ctrl

Coord -> Ctrl : POST /proyectos/nuevo\n[titulo, descripcion, objetivos, estado, fechaInicio, fechaFin]
activate Ctrl

note over Ctrl : @Valid / validarDatos — \ncampos requeridos en el binding

Ctrl -> Service : guardarProyecto(proyecto)
activate Service
Service -> Repo : save(proyecto)
activate Repo
Repo -> DB : INSERT INTO proyectos (...)
DB --> Repo : Proyecto (con id)
deactivate Repo
Repo --> Service : Proyecto
deactivate Service
Service --> Ctrl : Proyecto

Ctrl --> Coord : 302 redirect → /proyectos
deactivate Ctrl

@enduml
