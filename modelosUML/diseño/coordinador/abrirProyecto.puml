@startuml abrirProyecto-diseño
skinparam linetype ortho

actor "Coordinador" as Coord
participant "Navegador" as Nav
participant "ProyectoController\n@Controller\nGET /proyectos/{id}" as Ctrl
participant "ProyectoService\n@Service" as Service
participant "ProyectoRepository\nJpaRepository" as Repo
database "H2" as DB

Coord -> Nav : clic en un proyecto de la lista
activate Nav
Nav -> Ctrl : GET /proyectos/{id}
activate Ctrl

Ctrl -> Service : obtenerProyecto(id)
activate Service
Service -> Repo : findById(id)
activate Repo
Repo -> DB : SELECT * FROM proyectos WHERE id = ?
DB --> Repo : Proyecto
deactivate Repo
Repo --> Service : Optional<Proyecto>
deactivate Service
Service --> Ctrl : Proyecto

Ctrl -> Ctrl : model.addAttribute("proyecto", proyecto)
Ctrl --> Nav : 200 OK · proyecto.html
deactivate Ctrl
Nav --> Coord : muestra proyecto.html
deactivate Nav

@enduml
