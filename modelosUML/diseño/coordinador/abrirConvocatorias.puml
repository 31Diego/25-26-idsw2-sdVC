@startuml abrirConvocatorias-diseño
title Diagrama de Secuencia - Abrir Convocatorias

actor "Coordinador" as Coordinador
participant "Navegador\n(Thymeleaf)" as View
participant "ConvocatoriasController\n(@Controller)" as Controller
participant "ConvocatoriasService\n(@Service)" as Service
participant "ConvocatoriaRepository\n(JpaRepository)" as Repo
database "Base de Datos\n(H2)" as DB

== Carga inicial ==

Coordinador -> View: Navega a convocatorias
activate View
View -> Controller: GET /convocatorias
activate Controller
Controller -> Service: listarConvocatorias()
activate Service
Service -> Repo: findAll()
activate Repo
Repo -> DB: SELECT * FROM convocatorias
activate DB
DB --> Repo: List<Convocatoria>
deactivate DB
Repo --> Service: List<Convocatoria>
deactivate Repo
Service --> Controller: List<ConvocatoriaDTO>
deactivate Service
Controller --> View: convocatorias.html + List<ConvocatoriaDTO>
deactivate Controller
View --> Coordinador: Muestra lista de convocatorias
deactivate View

== Filtrado ==

Coordinador -> View: Aplica filtros (texto, área, estado)
activate View
View -> Controller: GET /convocatorias?texto=&area=&estado=
activate Controller
Controller -> Service: filtrarConvocatorias(texto, area, estado)
activate Service
Service -> Repo: buscarPorCriterio(texto, area, estado)
activate Repo
Repo -> DB: SELECT * FROM convocatorias\nWHERE titulo LIKE ? AND area = ? AND estado = ?
activate DB
DB --> Repo: List<Convocatoria>
deactivate DB
Repo --> Service: List<Convocatoria>
deactivate Repo
Service --> Controller: List<ConvocatoriaDTO>
deactivate Service
Controller --> View: convocatorias.html + List<ConvocatoriaDTO>
deactivate Controller
View --> Coordinador: Muestra lista filtrada
deactivate View

@enduml
