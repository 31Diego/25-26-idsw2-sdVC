@startuml eliminarProyecto-diseño
skinparam linetype ortho

actor "Coordinador" as Coord
participant "Navegador" as Nav
participant "ProyectoController\n@Controller\nGET|POST /proyectos/{id}/eliminar" as Ctrl
participant "ProyectoService\n@Service" as Service
participant "EntregableRepository\nJpaRepository" as EntRepo
participant "ProyectoRepository\nJpaRepository" as Repo
database "H2" as DB

Coord -> Nav : clic en "Eliminar"
activate Nav
Nav -> Ctrl : GET /proyectos/{id}/eliminar
activate Ctrl
Ctrl -> Service : obtenerProyecto(id)
activate Service
Service -> Repo : findById(id)
activate Repo
Repo -> DB : SELECT * FROM proyectos WHERE id = ?
DB --> Repo : Proyecto
deactivate Repo
Repo --> Service : Proyecto
deactivate Service
Service --> Ctrl : Proyecto
Ctrl -> Ctrl : model.addAttribute("proyecto", proyecto)
Ctrl --> Nav : 200 OK · eliminar-proyecto.html [confirmación]
deactivate Ctrl
Nav --> Coord : muestra página de confirmación
deactivate Nav

Coord -> Nav : confirma eliminación
activate Nav
Nav -> Ctrl : POST /proyectos/{id}/eliminar
activate Ctrl

Ctrl -> Service : eliminarProyecto(id)
activate Service
Service -> EntRepo : deleteByProyectoId(id)
activate EntRepo
EntRepo -> DB : DELETE FROM entregables WHERE proyecto_id = ?
DB --> EntRepo : ok
deactivate EntRepo
Service -> Repo : deleteById(id)
activate Repo
Repo -> DB : DELETE FROM proyectos WHERE id = ?
DB --> Repo : ok
deactivate Repo
deactivate Service

Ctrl --> Nav : 302 redirect → /proyectos
deactivate Ctrl
Nav --> Coord : navega a /proyectos
deactivate Nav

@enduml
