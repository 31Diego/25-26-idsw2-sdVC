@startuml eliminarProyecto-diseño
skinparam linetype ortho

actor "Coordinador" as Coord
participant "EliminarProyectoController\n@Controller\nGET|POST /proyectos/{id}/eliminar" as Ctrl
participant "ProyectoService\n@Service" as Service
participant "ProyectoRepository\nJpaRepository" as Repo
database "H2" as DB

Coord -> Ctrl : GET /proyectos/{id}/eliminar
activate Ctrl
Ctrl -> Service : obtenerProyecto(id)
activate Service
Service -> Repo : findById(id)
activate Repo
Repo -> DB : SELECT * FROM proyectos WHERE id = ?
DB --> Repo : Proyecto
deactivate Repo
Repo --> Service : Proyecto
deactivate Service
Service --> Ctrl : Proyecto
Ctrl -> Ctrl : model.addAttribute("proyecto", proyecto)
Ctrl --> Coord : 200 OK · eliminar-proyecto.html [confirmación]
deactivate Ctrl

Coord -> Ctrl : POST /proyectos/{id}/eliminar
activate Ctrl

Ctrl -> Service : eliminarProyecto(id)
activate Service
Service -> Repo : deleteById(id)
activate Repo
Repo -> DB : DELETE FROM proyectos WHERE id = ?
deactivate Repo
deactivate Service

Ctrl --> Coord : 302 redirect → /proyectos
deactivate Ctrl

@enduml
