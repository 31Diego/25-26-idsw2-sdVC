@startuml abrirPanelPrincipal-diseño
title Diagrama de Secuencia - Abrir Panel Principal

actor "Coordinador" as Coordinador
participant "Navegador\n(Thymeleaf)" as View
participant "PanelPrincipalController\n(@Controller)" as Controller
participant "PanelPrincipalService\n(@Service)" as Service

Coordinador -> View: Login exitoso o navega a /panel
activate View
View -> Controller: GET /panel
activate Controller
Controller -> Service: cargarPanel()
activate Service
Service --> Controller: void
deactivate Service
Controller --> View: panel.html
deactivate Controller
View --> Coordinador: Muestra panel con menú de navegación
deactivate View

@enduml
