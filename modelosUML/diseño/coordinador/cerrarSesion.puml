@startuml cerrarSesion-diseño
skinparam linetype ortho

actor "Coordinador" as Coord
participant "Navegador" as Nav
participant "Spring Security\nPOST /logout" as SS

Coord -> Nav : clic en "Cerrar sesión"
activate Nav
Nav -> SS : POST /logout
activate SS
SS -> SS : invalida HttpSession
SS -> SS : limpia SecurityContext
SS --> Nav : redirect /login?logout
deactivate SS
Nav --> Coord : muestra login.html con mensaje de cierre
deactivate Nav

@enduml
