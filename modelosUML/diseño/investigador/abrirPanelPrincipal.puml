@startuml abrirPanelPrincipal-diseño
skinparam linetype ortho

actor "Investigador" as Inv
participant "Navegador" as Nav
participant "PanelPrincipalController\n@Controller\nGET /panel" as Ctrl

Inv -> Nav : navega a /panel
activate Nav
Nav -> Ctrl : GET /panel
activate Ctrl
Ctrl --> Nav : 200 OK · panel.html
deactivate Ctrl
Nav --> Inv : muestra panel.html
deactivate Nav

@enduml
