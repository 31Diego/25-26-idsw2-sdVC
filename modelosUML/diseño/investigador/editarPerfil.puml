@startuml editarPerfil-investigador-diseño
skinparam linetype ortho

actor "Investigador" as Inv
participant "Navegador" as Nav
participant "EditarPerfilController\n@Controller\nGET /perfil/editar" as CtrlGet
participant "EditarPerfilController\n@Controller\nPOST /perfil/editar" as CtrlPost
participant "InvestigadorService\n@Service" as Service
participant "InvestigadorRepository\nJpaRepository" as Repo
database "H2" as DB

Inv -> Nav : clic en "Editar perfil" en opciones de perfil
activate Nav
Nav -> CtrlGet : GET /perfil/editar
activate CtrlGet
CtrlGet -> Service : obtenerInvestigadorPorUsername(username)
activate Service
Service -> Repo : findByUsername(username)
activate Repo
Repo -> DB : SELECT * FROM investigadores WHERE username = ?
DB --> Repo : Investigador
deactivate Repo
Repo --> Service : Investigador
deactivate Service
Service --> CtrlGet : Investigador
CtrlGet -> CtrlGet : model.addAttribute("investigador", investigador)
CtrlGet -> CtrlGet : model.addAttribute("esPropioPeril", true)
CtrlGet --> Nav : 200 OK · editar-perfil.html
deactivate CtrlGet
Nav --> Inv : muestra formulario sin campo rol
deactivate Nav

Inv -> Nav : rellena campos y pulsa "Guardar"
activate Nav
Nav -> CtrlPost : POST /perfil/editar (nombre, apellidos, campo, carrera, master)
activate CtrlPost
CtrlPost -> Service : actualizarPerfil(id, nombre, apellidos, campo, carrera, master)
activate Service
Service -> Repo : findById(id)
activate Repo
Repo -> DB : SELECT * FROM investigadores WHERE id = ?
DB --> Repo : Investigador
deactivate Repo
Service -> Repo : save(investigador)
Repo -> DB : UPDATE investigadores SET ... WHERE id = ?
Repo --> Service : Investigador
deactivate Service
Service --> CtrlPost : void
CtrlPost --> Nav : redirect /perfil/opciones
deactivate CtrlPost
Nav --> Inv : muestra opciones de perfil actualizadas
deactivate Nav

@enduml
