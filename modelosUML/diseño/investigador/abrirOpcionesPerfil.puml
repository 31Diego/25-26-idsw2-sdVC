@startuml abrirOpcionesPerfil-investigador-diseño
skinparam linetype ortho

actor "Investigador" as Inv
participant "Navegador" as Nav
participant "PerfilController\n@Controller\nGET /perfil/opciones" as Ctrl
participant "InvestigadorService\n@Service" as Service
participant "InvestigadorRepository\nJpaRepository" as Repo
database "H2" as DB

Inv -> Nav : clic en "Opciones de perfil" en el panel
activate Nav
Nav -> Ctrl : GET /perfil/opciones
activate Ctrl
Ctrl -> Service : obtenerInvestigadorPorUsername(username)
activate Service
Service -> Repo : findByUsername(username)
activate Repo
Repo -> DB : SELECT * FROM investigadores WHERE username = ?
DB --> Repo : Investigador
deactivate Repo
Repo --> Service : Investigador
deactivate Service
Service --> Ctrl : Investigador
Ctrl -> Ctrl : model.addAttribute("investigador", investigador)
Ctrl -> Ctrl : model.addAttribute("esPropioPeril", true)
Ctrl --> Nav : 200 OK · opciones-perfil.html
deactivate Ctrl
Nav --> Inv : muestra opciones del propio perfil
deactivate Nav

@enduml
