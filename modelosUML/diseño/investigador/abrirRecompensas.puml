@startuml
title Diagrama de Secuencia — abrirRecompensas (Investigador)

actor "Investigador" as User
participant "RecompensaController\n@Controller" as Controller
participant "RecompensaService\n@Service" as Service
participant "RecompensaRepository\nJpaRepository" as Repo
database "H2" as DB

User -> Controller: GET /recompensas
activate Controller
Controller -> Service: obtenerParaUsuario(investigador)
activate Service
note right of Service: rol == INVESTIGADOR\n→ obtenerPorDestinatario()
Service -> Repo: findByDestinatario(investigador)
activate Repo
Repo -> DB: SELECT * FROM recompensas\nWHERE destinatario_id = ?
activate DB
DB --> Repo: List<Recompensa>
deactivate DB
Repo --> Service: List<Recompensa>
deactivate Repo
Service --> Controller: List<Recompensa>
deactivate Service
Controller --> User: recompensas.html\n(solo las propias)
deactivate Controller

@enduml
